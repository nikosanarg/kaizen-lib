{
  "name": "kaizen-lib",
  "version": "0.2.22",
  "description": "Tokens y componentes compartidos entre los fronts de Kaizen.",
  "license": "MIT",
  "author": "Nicolás Sandobal",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nikosanarg/kaizen-lib.git"
  },
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "files": [
    "src",
    "dist",
    "!src/**/*.test.*",
    "!src/**/testing"
  ],
  "exports": {
    "./tokens": "./src/tokens/index.ts",
    "./tokens.css": "./src/tokens/defaults.css",
    "./ui": "./src/ui/index.ts",
    "./motion": "./src/motion/index.ts",
    "./efectos": "./src/efectos/index.ts",
    "./camisetas": {
      "types": "./src/camisetas/index.ts",
      "require": "./dist/camisetas/index.js",
      "default": "./src/camisetas/index.ts"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm run test",
    "build": "tsc -p tsconfig.cjs.json && node -e \"require('fs').writeFileSync('dist/camisetas/package.json','{\\\"type\\\":\\\"commonjs\\\"}')\"",
    "prepublishOnly": "npm run check && npm run build"
  },
  "peerDependencies": {
    "react": ">=19",
    "styled-components": ">=6",
    "motion": ">=12"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "styled-components": {
      "optional": true
    },
    "motion": {
      "optional": true
    }
  },
  "devDependencies": {
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.1",
    "@types/node": "24.10.1",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "jsdom": "29.1.1",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "styled-components": "6.4.2",
    "typescript": "5.9.3",
    "vitest": "5.0.1",
    "motion": "12.43.0"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0"
  },
  "typesVersions": {
    "*": {
      "camisetas": [
        "dist/camisetas/index.d.ts"
      ]
    }
  }
}
