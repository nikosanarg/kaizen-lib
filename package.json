{
  "name": "kaizen-lib",
  "version": "0.0.1",
  "description": "Tokens y componentes compartidos entre los fronts de Kaizen.",
  "license": "MIT",
  "author": "Nicolás Sandobal",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nikosanarg/kaizen-lib.git"
  },
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "files": [
    "src",
    "!src/**/*.test.ts",
    "!src/**/testing"
  ],
  "exports": {
    "./tokens": "./src/tokens/index.ts",
    "./tokens.css": "./src/tokens/defaults.css",
    "./package.json": "./package.json"
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm run test"
  },
  "devDependencies": {
    "@types/node": "24.10.1",
    "typescript": "5.9.3",
    "vitest": "5.0.1"
  },
  "engines": {
    "node": ">=20"
  }
}
